# MongoDB
MONGODB_URL=
MONGODB_DATABASE=hrms_db

# Organization-local holiday validation and reminder schedule
ORG_TIMEZONE=Asia/Kolkata

# Local development sample login
# HRMS_ENV=development
#DEMO_USER_NAME=HR Admin
#DEMO_USER_EMAIL=hr.admin@example.com
#DEMO_USER_MOBILE=9000000000
#DEMO_USER_ROLE=HR Admin
#DEMO_USER_PASSWORD=change-me-locally

# Activation email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
FRONTEND_URL=http://localhost:5173

# Local-only WFH face verification (no cloud calls)
# Set false to temporarily disable WFH check-in/check-out endpoints.
WFH_ATTENDANCE_ENABLED=true
WFH_TEMPLATE_ENCRYPTION_KEY=
# This threshold may be tightened below 0.48 but cannot be relaxed above it.
WFH_FACE_MATCH_TOLERANCE=0.48
# Accuracy limit defaults to 100 meters; lower values are allowed, higher values are capped.
WFH_MAX_LOCATION_ACCURACY_METERS=100
# Browser location timestamps older than this are rejected.
WFH_MAX_LOCATION_AGE_SECONDS=120
# Add the deployed HTTPS frontend origin when using a phone or remote browser.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this key private and stable; it encrypts ESSL API credentials and request parameters in MongoDB.
ESSL_CONFIG_ENCRYPTION_KEY=
